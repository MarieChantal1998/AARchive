# Public frontend configuration (never place secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500
PROCESSING_TIMEOUT_SECONDS=900
GENERATION_TIMEOUT_SECONDS=180

# Backblaze B2 S3-compatible API
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=aarchive-media
B2_KEY_ID=
B2_APP_KEY=
B2_PUBLIC_URL_BASE=

# AI analysis/transcription and Genblaze media generation
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional seeded demo overrides. Without these, bundled public demo metadata is used.
DEMO_PROJECT_ID=demo-coordinated-response
DEMO_VIDEO_URL=
DEMO_COVER_URL=
DEMO_NARRATION_URL=
