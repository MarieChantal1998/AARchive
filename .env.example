# Public frontend configuration (never place secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500
PROCESSING_TIMEOUT_SECONDS=900
GENERATION_TIMEOUT_SECONDS=480

# Backblaze B2 S3-compatible API
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=aarchive-media
B2_KEY_ID=
B2_APP_KEY=
B2_PUBLIC_URL_BASE=

# Zero-cost processing defaults
TRANSCRIPTION_PROVIDER=local_whisper
LOCAL_WHISPER_MODEL=tiny.en
ANALYSIS_PROVIDER=local

# Genblaze media generation. Public deployments stay cached-only.
GENERATION_PROVIDER=gmicloud
GENERATION_MODE=cached_only
LOCAL_IMAGE_MODEL=pillow-lesson-card-v1
LOCAL_AUDIO_MODEL=macos-say-tts-v1
LOCAL_TTS_VOICE=Samantha
LOCAL_TTS_RATE=155
GMI_API_KEY=
GMI_TEXT_MODEL=deepseek-ai/DeepSeek-V3
GMI_IMAGE_MODEL=seedream-5.0-lite
GMI_AUDIO_MODEL=elevenlabs-tts-v3
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_AUDIO_MODEL=nvidia/magpie-tts-multilingual
NVIDIA_HTTP_TIMEOUT_SECONDS=360
NVIDIA_TTS_SYNTHESIZE_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
NVIDIA_TTS_VOICES_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/list_voices
# Leave false in normal/public operation. The guarded demo run has already completed and is cached in B2.
NVIDIA_TTS_ONE_SHOT_ENABLED=false

# Optional production provider; disabled unless explicitly selected and funded.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional seeded demo overrides. Without these, bundled public demo metadata is used.
DEMO_PROJECT_ID=demo-coordinated-response
DEMO_VIDEO_URL=
DEMO_COVER_URL=
DEMO_NARRATION_URL=
